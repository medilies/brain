{
  "extraKnownMarketplaces": {
    "brain": {
      "source": { "source": "directory", "path": "{{brain}}" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "brain@brain": true,
    "code-review@brain": true,
    "domain-modeling@brain": true,
    "grill-with-docs@brain": true,
    "grilling@brain": true,
    "prototype@brain": true,
    "research@brain": true,
    "setup-matt-pocock-skills@brain": true,
    "wayfinder@brain": true,
    "tui-test@brain": true
  },
  "theme": "dark",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "deny": [
      "NotebookEdit",
      "DesignSync",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterPlanMode",
      "ExitPlanMode",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableBundledSkills": true,
  "enableArtifact": true
}
